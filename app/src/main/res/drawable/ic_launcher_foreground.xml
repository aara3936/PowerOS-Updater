                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:startColor="#00F5FF"
                android:endColor="#0066FF" />
        </aapt:attr>
    </path>

    <!-- Inner cutout of P with midnight background color -->
    <path
        android:pathData="M50,40 L60,40 C63.5,40 66.5,42 66.5,45 C66.5,48 63.5,50 60,50 L50,50 Z"
        android:fillColor="#0F172A" />

