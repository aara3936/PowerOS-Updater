<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Cyan Glow Halo -->
    <path
        android:pathData="M38,28 L62,28 C73,28 80,35 80,45 C80,55 73,62 62,62 L50,62 L50,80 L38,80 Z"
        android:strokeWidth="4"
        android:strokeColor="#4000E5FF" />

    <!-- Frosted Neon 'P' Solid Base with Cyan to Blue Gradient -->
    <path
        android:pathData="M38,28 L62,28 C73,28 80,35 80,45 C80,55 73,62 62,62 L50,62 L50,80 L38,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:startColor="#00E5FF"
                android:endColor="#0077FF" />
        </aapt:attr>
    </path>

    <!-- Inner 'P' Cutout with Dark Glass Fill -->
    <path
        android:pathData="M50,40 L60,40 C64,40 67,42 67,45 C67,48 64,50 60,50 L50,50 Z"
        android:fillColor="#09101F" />

    <!-- Glass Refraction Edge Highlight -->
    <path
        android:pathData="M38,28 L62,28 C73,28 80,35 80,45"
        android:strokeWidth="1.5"
        android:strokeColor="#CCFFFFFF" />
</vector>
