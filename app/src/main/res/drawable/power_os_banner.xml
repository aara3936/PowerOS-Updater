<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="140dp"
    android:viewportWidth="360"
    android:viewportHeight="140">

    <path
        android:pathData="M0,0h360v140h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="360"
                android:endY="140"
                android:startColor="#0D192E"
                android:endColor="#040914" />
        </aapt:attr>
    </path>

    <!-- Glowing Waves / Fluid Mesh -->
    <path
        android:pathData="M0,80 Q90,30 180,90 T360,60 L360,140 L0,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="60"
                android:endX="360"
                android:endY="140"
                android:startColor="#2200E5FF"
                android:endColor="#0A0077FF" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M0,100 Q120,60 240,110 T360,80 L360,140 L0,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="80"
                android:endX="360"
                android:endY="140"
                android:startColor="#3300E5FF"
                android:endColor="#110099FF" />
        </aapt:attr>
    </path>

    <!-- Circuit grid lines -->
    <path
        android:pathData="M40,20 L120,20 L150,50 L280,50 M80,80 L180,80 L210,110"
        android:strokeWidth="1.2"
        android:strokeColor="#2600E5FF" />
</vector>
